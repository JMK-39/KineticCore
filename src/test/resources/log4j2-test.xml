<?xml version="1.0" encoding="UTF-8"?>
<!--
  Regression JVMs log to the console only. Without this file Forge's log4j2.xml applies and writes logs/latest.log
  and logs/debug.log into the working directory, which for these checks is the project root.
-->
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="[%d{HH:mm:ss}] [%t/%level] [%logger{1}]: %msg%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <Root level="info">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
